<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>FARMCARE_BACKEND</key>
	<string>$(FARMCARE_BACKEND)</string>
	<key>FARMCARE_API_HOST</key>
	<string>$(FARMCARE_API_HOST)</string>
	<key>FARMCARE_API_SCHEME</key>
	<string>$(FARMCARE_API_SCHEME)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>FarmCare uses your local network to connect to your farm's server.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string></string>
			<key>LSHandlerRank</key>
			<string>None</string>
		</dict>
		<dict/>
	</array>
	<key>SUPABASE_KEY</key>
	<string>$(SUPABASE_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
</dict>
</plist>
