// Copy to Secrets.xcconfig in this same folder. Preserve any existing file.
// New API (run the local backend first). Separate scheme/host avoids // comments.
FARMCARE_BACKEND = custom
FARMCARE_API_SCHEME = http
FARMCARE_API_HOST = localhost:8000
// Release builds require HTTPS. Device testing needs a reachable hostname.
// To keep the existing backend, set FARMCARE_BACKEND = supabase instead.
// Hostname only: omitting https:// avoids xcconfig's // comment syntax.
SUPABASE_URL = YOUR_PROJECT_REF.supabase.co
// Public anon or publishable key only; never use a service_role or secret key.
SUPABASE_KEY = YOUR_PUBLIC_KEY
