# Run python3 scripts/init_local.py to generate a private local .env instead.
FARMCARE_ENV=development
FARMCARE_DB_PASSWORD=
FARMCARE_SIGNING_KEY=
FARMCARE_DATABASE_URL=
FARMCARE_PUBLIC_URL=http://localhost:8000
# Compose uses Mailpit. Native development can omit SMTP to write private .mail/*.eml files.
FARMCARE_SMTP_HOST=
FARMCARE_SMTP_PORT=1025
FARMCARE_SMTP_STARTTLS=false
FARMCARE_SMTP_USER=
FARMCARE_SMTP_PASSWORD=
FARMCARE_MAIL_FROM=FarmCare <noreply@farmcare.local>
